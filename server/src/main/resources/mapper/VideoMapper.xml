<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.server.server.mapper.VideoMapper">

    <resultMap id="VideoResultMap" type="Video">
        <id property="id" column="id"/>
        <result property="courseId" column="course_id"/>
        <result property="title" column="title"/>
        <result property="url" column="url"/>
        <result property="duration" column="duration"/>
        <result property="sortOrder" column="sort_order"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <select id="findByCourseId" resultMap="VideoResultMap">
        SELECT * FROM videos WHERE course_id = #{courseId} ORDER BY sort_order ASC
    </select>

    <select id="findById" resultMap="VideoResultMap">
        SELECT * FROM videos WHERE id = #{id}
    </select>

    <select id="countPublishedByUrl" resultType="int">
        SELECT COUNT(*) FROM videos v JOIN courses c ON v.course_id = c.id
        WHERE v.url = #{url} AND c.status = 1
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO videos(course_id, title, url, duration, sort_order, create_time)
        VALUES(#{courseId}, #{title}, #{url}, #{duration}, #{sortOrder}, NOW())
    </insert>

    <update id="update">
        UPDATE videos
        <set>
            <if test="title != null">title = #{title},</if>
            <if test="url != null">url = #{url},</if>
            <if test="duration != null">duration = #{duration},</if>
            <if test="sortOrder != null">sort_order = #{sortOrder},</if>
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM videos WHERE id = #{id}
    </delete>

    <delete id="deleteByCourseId">
        DELETE FROM videos WHERE course_id = #{courseId}
    </delete>

</mapper>
