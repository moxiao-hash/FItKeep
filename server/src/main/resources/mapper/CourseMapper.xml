<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.server.server.mapper.CourseMapper">

    <resultMap id="CourseResultMap" type="Course">
        <id property="id" column="id"/>
        <result property="title" column="title"/>
        <result property="description" column="description"/>
        <result property="cover" column="cover"/>
        <result property="category" column="category"/>
        <result property="difficulty" column="difficulty"/>
        <result property="duration" column="duration"/>
        <result property="teacherId" column="teacher_id"/>
        <result property="teacherName" column="teacher_name"/>
        <result property="status" column="status"/>
        <result property="viewCount" column="view_count"/>
        <result property="enrollCount" column="enroll_count"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <select id="findAll" resultMap="CourseResultMap">
        SELECT * FROM courses
        <where>
            <if test="category != null and category != ''">AND category = #{category}</if>
            <if test="difficulty != null">AND difficulty = #{difficulty}</if>
        </where>
        ORDER BY create_time DESC
    </select>

    <select id="findPublished" resultMap="CourseResultMap">
        SELECT * FROM courses
        <where>
            status = 1
            <if test="category != null and category != ''">AND category = #{category}</if>
        </where>
        ORDER BY create_time DESC
    </select>

    <select id="findById" resultMap="CourseResultMap">
        SELECT * FROM courses WHERE id = #{id}
    </select>

    <select id="countAll" resultType="int">
        SELECT COUNT(*) FROM courses
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO courses(title, description, cover, category, difficulty, duration, teacher_id, teacher_name, status, view_count, enroll_count, create_time, update_time)
        VALUES(#{title}, #{description}, #{cover}, #{category}, #{difficulty}, #{duration}, #{teacherId}, #{teacherName}, #{status}, 0, 0, NOW(), NOW())
    </insert>

    <update id="update">
        UPDATE courses
        <set>
            <if test="title != null">title = #{title},</if>
            <if test="description != null">description = #{description},</if>
            <if test="cover != null">cover = #{cover},</if>
            <if test="category != null">category = #{category},</if>
            <if test="difficulty != null">difficulty = #{difficulty},</if>
            <if test="duration != null">duration = #{duration},</if>
            <if test="status != null">status = #{status},</if>
            update_time = NOW()
        </set>
        WHERE id = #{id}
    </update>

    <update id="incrementViewCount">
        UPDATE courses SET view_count = view_count + 1 WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM courses WHERE id = #{id}
    </delete>

</mapper>
