<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.server.server.mapper.CheckInMapper">

    <resultMap id="CheckInResultMap" type="CheckIn">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="username" column="username"/>
        <result property="checkDate" column="check_date"/>
        <result property="content" column="content"/>
        <result property="duration" column="duration"/>
        <result property="imageUrl" column="image_url"/>
        <result property="likeCount" column="like_count"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <select id="findByUserId" resultMap="CheckInResultMap">
        SELECT c.*, u.username FROM checkins c LEFT JOIN users u ON c.user_id = u.id
        WHERE c.user_id = #{userId} ORDER BY c.check_date DESC
    </select>

    <select id="findAll" resultMap="CheckInResultMap">
        SELECT c.*, u.username FROM checkins c LEFT JOIN users u ON c.user_id = u.id
        ORDER BY c.create_time DESC
    </select>

    <select id="findByUserIdAndDate" resultMap="CheckInResultMap">
        SELECT * FROM checkins WHERE user_id = #{userId} AND check_date = #{checkDate}
    </select>

    <select id="countByUserId" resultType="int">
        SELECT COUNT(*) FROM checkins WHERE user_id = #{userId}
    </select>

    <select id="countAll" resultType="int">
        SELECT COUNT(*) FROM checkins
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO checkins(user_id, check_date, content, duration, image_url, like_count, create_time)
        VALUES(#{userId}, #{checkDate}, #{content}, #{duration}, #{imageUrl}, 0, NOW())
    </insert>

    <delete id="deleteById">
        DELETE FROM checkins WHERE id = #{id}
    </delete>

</mapper>
